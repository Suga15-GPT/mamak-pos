# Copy this file to .env and fill in real values. Never commit .env.

# Any characters work, / + = # @ included: the app is given the password on
# its own, never inside a URL. If it has a $ or a space in it, put the whole
# value in single quotes.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
ADMIN_PIN=change-me

# BASE_URL must be this PC's LAN address, e.g. http://192.168.x.x:3000 (on
# Windows, `ipconfig` shows it as the IPv4 Address). Never localhost: every QR
# code and NFC tag contains this address, and on a customer's phone localhost
# means the phone itself. Give this PC a fixed address in the router so it
# does not change. After changing BASE_URL, restart, reprint the QR codes and
# rewrite the NFC tags. Left empty, it becomes http://localhost:3000, and the
# app warns about it every time it starts.
BASE_URL=
PORT=3000
TZ=Asia/Kuala_Lumpur

# Off-device backup destination (optional but strongly recommended — a local
# backup dies with the machine it is on). One of:
#   s3://bucket/prefix     (needs the aws CLI plus AWS_* credentials in .env)
#   user@host:/path        (needs rsync and a mounted SSH key)
#   /mnt/nas/mamak         (a mounted NAS or external disk)
# BACKUP_REMOTE_TARGET=

# ---------------------------------------------------------------------------
# READING RECEIPTS FOR 🧾 EXPENSES (optional)
#
# With a key, a photo of a receipt or a voice note ("beli ayam 20 kilo, RM180
# cash") fills in the expense form; you still check it and press Save. Without
# one, Expenses works by typing. Get a free key at https://aistudio.google.com
# (Get API key). Google's free tier is plenty for a restaurant's receipts, but
# on the free tier Google may use what you send to improve its products — send
# supplier receipts, never anything about customers.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# The model can change as Google renames models; this is the default.
# GEMINI_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# SPEAK TO ORDER (optional)
#
# Off unless VOICE_ORDERING=1. While it is off, the QR page is exactly what it
# was — a menu you tap — and the microphone button never appears.
#
# Two vendors are involved and both are configured here, on the server. No key
# is ever sent to a browser, and the POS remains the system of record: the
# model may only ever name menu item ids, and every price on the customer's
# preview is read back out of this database.
# ---------------------------------------------------------------------------
# VOICE_ORDERING=1

# Speech to text. Any endpoint that speaks the OpenAI /audio/transcriptions
# shape works — OpenAI, Groq, or a whisper server you run yourself.
# VOICE_STT_URL=https://api.openai.com/v1/audio/transcriptions
# VOICE_STT_MODEL=whisper-1
# VOICE_STT_API_KEY=

# Interpretation. Anthropic's Messages API; the key is read from the standard
# variable. Opus 5 is the default because it reads Manglish code-switching
# ("teh tarik dua, kurang manis") most reliably. A cheaper model costs less per
# order and mishears more — see docs/RUNBOOK.md before changing it.
# ANTHROPIC_API_KEY=
# VOICE_LLM_MODEL=claude-opus-5

# Development only. Replaces both vendors with a local word matcher so the whole
# flow can be walked through without an account anywhere. Never set this in
# production: it "hears" only VOICE_MOCK_TRANSCRIPT, not the microphone.
# VOICE_MODE=mock
# VOICE_MOCK_TRANSCRIPT=roti canai dua, teh tarik satu
