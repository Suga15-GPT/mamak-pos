# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
ADMIN_PIN=change-me
BASE_URL=http://localhost:3000
PORT=3000
TZ=Asia/Kuala_Lumpur

# Off-device backup destination (optional but strongly recommended — a local
# backup dies with the machine it is on). One of:
#   s3://bucket/prefix     (needs the aws CLI plus AWS_* credentials in .env)
#   user@host:/path        (needs rsync and a mounted SSH key)
#   /mnt/nas/mamak         (a mounted NAS or external disk)
# BACKUP_REMOTE_TARGET=
